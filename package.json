{
  "name": "piratemedia.tv",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "npx http-server",
    "build": "npm run build:fs && npm run build:cv && npm run build:routes",
    "build:fs": "exportFileSystem ./fs -v fs --binary --compress -h -o public/fs.js",
    "build:cv": "mdcv ./fs/work/cv --primaryColor 00c0ff --secondaryColor FF1955 -o ./public",
    "build:routes": "mkdir -p public/projects && cp public/index.html public/projects/index.html",
    "test:spelling": "spellchecker --files 'fs/work/**/*.md' '!fs/work/help.md' -l en-GB -d dictionary.txt",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "ansi-256-colors": "^1.1.0",
    "marked": "^2.1.3",
    "marked-terminal": "^4.1.1",
    "mdcv": "github:eliotstocker/mdcv"
  },
  "devDependencies": {
    "brsh": "^3.0.0",
    "spellchecker-cli": "^6.0.2"
  }
}
