#!/bin/sh

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  echo "askcv - Ask questions about Eliot Stocker using local AI (wllama)"
  echo ""
  echo "Usage:"
  echo "  askcv \"<question>\"    Ask a question about Eliot's experience"
  echo "  askcv                 Start an interactive chat session about Eliot's CV"
  echo ""
  echo "Examples:"
  echo "  askcv \"What did Eliot do at Snyk?\""
  echo "  askcv \"Tell me about Eliot's leadership experience\""
  echo "  askcv \"What technologies does Eliot have experience with?\""
else
  if ! which wllama > /dev/null 2>&1; then
    echo "wllama engine not found. Installing wllama via wbt..."
    wbt install wllama
  fi

  cv_data=$(cat /work/cv/title.md /work/cv/contact.md /work/cv/info.md /work/cv/employment/01-attest.md /work/cv/employment/05-snyk.md /work/cv/employment/10-brandwatch.md /work/cv/employment/20-rto.md /work/cv/employment/30-freelance.md /work/cv/employment/40-noonan.md /work/cv/references.md /work/cv/other.md)

  system_prompt="You are an AI assistant answering questions about Eliot Stocker based on his CV and professional experience.
Be concise, accurate, helpful, and professional.
Only answer questions using the CV data below. If something is not covered, state that you do not have that information.

=== ELIOT STOCKER CV DATA ===
$cv_data
=== END CV DATA ==="

  if [ $# -gt 0 ]; then
    wllama --hf Qwen/Qwen2.5-0.5B-Instruct-GGUF --quant Q4_K_M -s "$system_prompt" -p "$*"
  else
    wllama --hf Qwen/Qwen2.5-0.5B-Instruct-GGUF --quant Q4_K_M -s "$system_prompt"
  fi
fi
